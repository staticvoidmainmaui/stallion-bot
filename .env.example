# --- Claude ---
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# --- Minutes source (pick one) ---
# Google Doc ID from docs.google.com/document/d/<THIS_PART>/edit
MINUTES_DOC_ID=
# Path to the service-account JSON key (share the doc with its client_email as Viewer)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Offline testing instead of Google Docs:
# MINUTES_TEXT_FILE=fixtures/minutes-2026-10-25.txt

# --- WhatsApp ---
# Leave empty on first run, send !groupid in the group, paste the value here, restart.
CHAPTER_GROUP_JID=
# Comma-separated phone numbers (country code first, digits only) allowed to run !tag/!followup/!goals/!refresh.
# Roster entries with "isExec": true are also exec.
EXEC_NUMBERS=

# --- Behaviour ---
TZ=America/New_York
REMINDERS_ENABLED=true
SEND_GAP_MS=1500
ROSTER_PATH=roster.json
DB_PATH=data/stallion.db
AUTH_DIR=auth

# --- v1.1: digest, demo mode, names ---
# all = every command; digest = only !digest / !weekly / !remind / !help (demo)
BOT_MODE=all
GLOSSARY_PATH=glossary.json
CHAPTER_TIME=18:30
CHAPTER_LOCATION=McCarty B G108
DIGEST_STICKER=assets/ufbetas-summary-sticker.webp
BOT_STICKER=assets/stallion-sticker.webp
# --- schedule (see SCHEDULE.md) ---
# Monday 9 PM weekly digest, held until the minutes are from that day's meeting
WEEKLY_DIGEST_CRON=0 21 * * 1
# 8 PM "Tomorrow" post, every night except Monday
TOMORROW_CRON=0 20 * * 0,2-6
# "Starting soon" this many hours before events people signed up for
SOON_HOURS=2
# Thursday 6 PM need-bros nudge + follow-up polls
NEED_BROS_CRON=0 18 * * 4
NEED_BROS_NUDGE=true
# Nothing automatic posts overnight
QUIET_START=22:30
QUIET_END=08:00
# --- safety (see SCHEDULE.md) ---
# Most automatic posts per day; anything past this is held and logged
MAX_AUTO_POSTS_PER_DAY=8
# Automatic posts pause if the minutes' meeting date is older than this, or in the future
STALE_MINUTES_DAYS=9
# true = only log what would post (try settings without touching the group)
AUTO_DRY_RUN=false
